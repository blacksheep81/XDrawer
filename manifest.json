{
  "manifest_version": 3,
  "name": "X 抽屉",
  "version": "0.12.0",
  "description": "在你自己的浏览器中整理 X 书签、喜欢和手动保存帖子的本地资料库",
  "permissions": ["tabs", "storage", "cookies"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*"],
  "action": {
    "default_title": "打开 X 抽屉",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["status-path.js", "capture.js"],
      "run_at": "document_idle"
    }
  ]
}
