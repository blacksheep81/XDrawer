{
  "manifest_version": 3,
  "name": "拾羽 - X 收藏库",
  "version": "0.12.0",
  "description": "把 X 上的书签、喜欢和手动保存的帖子，一片片拾进你自己浏览器里的本地收藏库",
  "permissions": ["tabs", "storage", "cookies", "identity", "alarms"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://www.googleapis.com/*", "https://oauth2.googleapis.com/*"],
  "action": {
    "default_title": "打开拾羽",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["status-path.js", "capture.js"],
      "run_at": "document_idle"
    }
  ]
}
